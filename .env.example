# Telegram
BOT_TOKEN=here
ADMIN_ID=here

# Прокси только если он реально доступен. Пусто = прямое соединение.
# Пример: TELEGRAM_PROXY_URL=socks5://127.0.0.1:10801
TELEGRAM_PROXY_URL=

# VK adapter MVP. По умолчанию VK runtime не запускается.
VK_ENABLED=false
VK_GROUP_ID=123456789
VK_GROUP_TOKEN=
VK_API_VERSION=5.199
VK_LONGPOLL_WAIT=25

# Web/Site adapter MVP. По умолчанию Web runtime не запускается.
WEB_ENABLED=false
WEB_API_TOKEN=
WEB_PUBLIC_BASE_URL=

# MongoDB
MONGODB_URI=mongodb://localhost:27017
DB_NAME=comm

# Base URL for Communars feedback page links (no API in Patch A)
SITE_FEEDBACK_BASE_URL=here
# Patch C: private bridge; separate process, never expose this port publicly
SITE_FEEDBACK_SYNC_URL=here
SITE_FEEDBACK_SYNC_TOKEN=here
SITE_FEEDBACK_SYNC_INTERVAL=20
